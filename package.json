{
  "name": "@ds/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise React component library with token-based theming, and validation rules that run without React.",
  "scripts": {
    "build": "npm run build:tokens && npm run build:css && npm run build:js",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "sass src/styles/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:js": "esbuild src/main.tsx --bundle --minify --sourcemap --target=es2020 --format=iife --outfile=assets/js/bundle.js",
    "dev": "npm run build:tokens && concurrently -n css,js -c magenta,yellow \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "sass src/styles/main.scss assets/css/main.css --watch",
    "dev:js": "esbuild src/main.tsx --bundle --sourcemap --target=es2020 --format=iife --outfile=assets/js/bundle.js --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test scripts/*.test.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run check:contrast",
    "serve": "bundle exec jekyll serve --livereload"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0"
  }
}
